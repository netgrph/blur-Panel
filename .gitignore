# Reference material kept locally for development but not shipped in the
# public repo — Adobe SDKs, scripting guides, the wrapped tool's source,
# and the compiled blur-master binaries.
knowledgebase/

# Personal/planning markdowns not relevant to a public repo.
*goal*.md

# Per-user runtime settings written by the panel at runtime.
com.blur.panel/config/user-settings.json

.vs/
CLAUDE.md
BUILD-GUIDE.md

# Python bytecode caches — these get regenerated locally when the bundled
# blur Python modules first run, and the .pyc files embed the absolute
# source path from the build machine (a PII leak).
__pycache__/
*.pyc
*.pyo

# Hand-built SVG mockups of the panel UI for use in motion graphics work.
# Local-only — not shipped or referenced by the panel.
ui-svg-export/

